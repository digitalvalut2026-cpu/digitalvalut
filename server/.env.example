# ==============================================================================
# DIGITAL VAULT - SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual production/test credentials.
# NEVER commit .env to GitHub or public repositories!
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
# URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key (Used for secured server-side DB operations)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Cloudflare R2 Storage (For storing private product ZIPs, PDFs & assets)
# From Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=digital-vault-assets

# Razorpay Payment Gateway Credentials (from Razorpay Dashboard -> Settings -> API Keys)
# Key ID is public/frontend safe, Key Secret MUST remain private on server!
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourSecretKeyHere

# Optional: Razorpay Webhook Secret for automated payment verification
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Security & Admin Authentication
JWT_SECRET=super_secret_cryptographically_secure_jwt_key_2026_digital_vault

# Allowed CORS Origins (Comma-separated list of domains allowed to make requests)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000
